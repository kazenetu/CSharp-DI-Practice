{
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": false,
        "TimestampFormat": "[yyyy/MM/dd HH:mm:ss] ",
        "IncludeScopes": false
      }
    },
    "FileLogger": {
      "Directory": "logs",
      "FileNamePrefix": "log",
      "RetainedFileCount": 0
    }
  }
}